db.Actor.find().sort({ age: 1 })

/* ============================================================
 * 2. companyDB — employees: update, delete, count
 * ============================================================ */
use companyDB

db.employees.insertMany([
  { id: 1, fname: 'Prathmesh', designation: 'manager', salary: 50000, address: 'Pune' },
  { id: 2, fname: 'Pranav', designation: 'Hr', salary: 30000, address: 'Pune' },
  { id: 3, fname: 'Banti', designation: 'Operation', salary: 40000, address: 'Mumbai' },
  { id: 4, fname: 'bhavesh', designation: 'technical', salary: 34000, address: 'Pune' }
])

// Give every employee a raise
db.employees.updateMany({}, { $inc: { salary: 4000 } })

// Update a single employee's address
db.employees.updateOne({ id: 2 }, { $set: { address: 'Delhi' } })

// Employees who are manager or Hr
db.employees.find({ $or: [{ designation: 'manager' }, { designation: 'Hr' }] })

// Sort by designation descending
db.employees.find().sort({ designation: -1 })

// Remove employees whose first name starts with 'P' or 'b'
db.employees.deleteMany({ fname: { $regex: "^P" } })
db.employees.deleteOne({ fname: { $regex: "^b" } })

db.employees.find()
db.employees.countDocuments({ salary: { $gt: 40000 } })

/* ============================================================
 * 3. deptDB — students: projection, sort+limit, forEach, $or/$in
 * ============================================================ */
use deptDB

db.students.insertMany([
  { id: 1, Fname: 'Pranav', age: 20, gender: 'M', city: 'Pune', percentage: 88 },
  { id: 2, Fname: 'Ravi', age: 23, gender: 'F', city: 'Mumbai', percentage: 34 },
  { id: 3, Fname: 'Shashi', age: 21, gender: 'F', city: 'Thane', percentage: 70 },
  { id: 4, Fname: 'Rahul', age: 22, gender: 'F', city: 'Pune', percentage: 90 }
])

// Count students above 80%
db.students.countDocuments({ percentage: { $gt: 80 } })

// Oldest student among those below 40%, only Fname/age fields
db.students.find(
  { percentage: { $lt: 40 } },
  { Fname: 1, age: 1, _id: 0 }
).sort({ age: -1 }).limit(1)

// Print names of students above 70%
db.students.find({ percentage: { $gt: 70 } }).forEach(doc => print(doc.name))

// Female students from Pune/Thane, or with percentage above 70
db.students.find({
  gender: 'F',
  $or: [
    { city: { $in: ['Pune', 'Thane'] } },
    { percentage: { $gt: 70 } }
  ]
})

/* ============================================================
 * 4. sales — aggregation with $lookup
 * ============================================================ */
use sales

db.product.insertMany([
  { pid: 1, Pname: 'Laptop', price: 65000 },
  { pid: 2, Pname: 'MacB', price: 154000 },
  { pid: 3, Pname: 'Phone', price: 5000 },
  { pid: 4, Pname: 'Tablet', price: 50000 }
])

db.orders.insertMany([
  { orderId: 1, cust_name: 'Prathmesh', value: 4500, invoiceID: 101 },
  { orderId: 2, cust_name: 'Pranav', value: 500 }
])

db.invoice.insertMany([
  { invoiceID: 101, orderId: 1, GeneratedOn: '20/01/2022' }
])

db.product.find({ price: { $gt: 10000 } })
db.orders.find({ invoiceID: { $exists: false } })

// Join orders with invoice details for a given customer
db.orders.aggregate([
  { $match: { cust_name: 'Prathmesh' } },
  {
    $lookup: {
      from: 'invoice',
      localField: 'invoiceID',
      foreignField: 'invoiceID',
      as: 'invoice_details'
    }
  }
])

